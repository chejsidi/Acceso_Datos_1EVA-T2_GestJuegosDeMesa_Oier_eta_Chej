**/.mvn/timing.properties
!**/.mvn/wrapper/maven-wrapper.jar

# ============================================
#  .gitignore para Java + IntelliJ IDEA
# ============================================

# ---------- Java ----------
# Archivos compilados
*.class

# Logs
*.log

# Paquetes generados
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs de fallos de la JVM
hs_err_pid*
replay_pid*

# BlueJ
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# ---------- Maven ----------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Mantener el wrapper de Maven
!.mvn/wrapper/maven-wrapper.jar

# ---------- Gradle ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- IntelliJ IDEA ----------
# Carpeta de configuración del proyecto (ignorada por completo)
.idea/
*.iml
*.ipr
*.iws
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Plugins de IntelliJ
.idea_modules/
atlassian-ide-plugin.xml
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# ---------- Sistema operativo ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ---------- Varios ----------
# Variables de entorno y secretos
.env
*.env
application-local.properties
application-local.yml

# Temporales
*.tmp
*.bak
*.swp